{
	"name": "sql-param-chunk",
	"version": "0.1.0",
	"description": "Split rows and IN-list values into chunks that stay under each database's bound-parameter limit (D1, SQLite, Postgres, MySQL, SQL Server). Works with any driver or ORM",
	"license": "MIT",
	"author": "Ankur Dubey (https://github.com/RagedPanda)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RagedPanda/sql-param-chunk.git"
	},
	"type": "module",
	"main": "./dist/cjs/index.js",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\"",
		"coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.ts\"",
		"bench": "node bench/index.ts",
		"prepublishOnly": "npm run typecheck && npm test && npm run build"
	},
	"keywords": [
		"sql",
		"chunk",
		"batch",
		"bulk-insert",
		"insert",
		"bind-parameters",
		"placeholders",
		"too-many-sql-variables",
		"in-list",
		"d1",
		"sqlite",
		"postgres",
		"mysql",
		"mssql",
		"kysely",
		"prisma",
		"typeorm",
		"drizzle"
	],
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.16",
		"@electric-sql/pglite-socket": "^0.2.19",
		"@types/better-sqlite3": "^9.6.0",
		"@types/lodash.chunk": "^4.2.9",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"better-sqlite3": "^12.11.1",
		"drizzle-chunked-insert": "^0.1.1",
		"drizzle-orm": "^0.45.4",
		"kysely": "^0.29.9",
		"lodash.chunk": "^4.2.0",
		"miniflare": "^4.20260730.0",
		"pg": "^8.23.1",
		"typeorm": "^1.1.3",
		"typescript": "^7.0.2"
	}
}
